@model IEnumerable<FeedbackManagementApp.Models.Feedback>

@{
    ViewData["Title"] = "Feedback Dashboard";
}

<div class="container px-0">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert" style="background-color: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3) !important;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="glass-card p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Average Rating</span>
                    <h2 class="display-6 fw-bold mb-0 text-white mt-1">@ViewBag.AverageRating <span class="fs-5 text-warning"><i class="bi bi-star-fill"></i></span></h2>
                </div>
                <div class="fs-1 text-warning opacity-75">
                    <i class="bi bi-stars"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Total Feedbacks</span>
                    <h2 class="display-6 fw-bold mb-0 text-white mt-1">@ViewBag.TotalCount</h2>
                </div>
                <div class="fs-1 text-primary opacity-75">
                    <i class="bi bi-chat-square-quote"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">5-Star Reviews</span>
                    <h2 class="display-6 fw-bold mb-0 text-white mt-1">@ViewBag.FiveStarCount</h2>
                </div>
                <div class="fs-1 text-success opacity-75">
                    <i class="bi bi-award-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Feed Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Recent User Feedbacks</h4>
        <a asp-action="Create" class="btn btn-sm btn-outline-light rounded-pill px-3">
            <i class="bi bi-plus-lg"></i> Add New
        </a>
    </div>

    <!-- Feedback List / Empty State -->
    @if (!Model.Any())
    {
        <div class="glass-card p-5 text-center">
            <i class="bi bi-inbox fs-1 text-secondary"></i>
            <h5 class="mt-3 text-secondary">No feedbacks submitted yet</h5>
            <p class="text-muted small">Be the first to share your thoughts!</p>
            <a asp-action="Create" class="btn btn-modern mt-2">Submit Feedback</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6">
                    <div class="glass-card p-4 h-100 d-flex flex-direction-column justify-content-between" style="border-left: 4px solid var(--accent-primary);">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-white">@item.FullName</h6>
                                    <span class="small text-muted">@item.Email</span>
                                </div>
                                <span class="badge bg-dark border border-secondary text-light">@item.Category</span>
                            </div>

                            <div class="mb-3 text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Rating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-secondary"></i>
                                    }
                                }
                            </div>

                            <p class="text-light mb-4" style="font-size: 0.95rem; line-height: 1.5;">
                                "@item.Comments"
                            </p>
                        </div>

                        <div class="text-muted small border-top pt-2" style="border-color: rgba(255,255,255,0.05) !important;">
                            <i class="bi bi-clock me-1"></i> @item.SubmittedAt.ToString("MMM dd, yyyy - hh:mm tt")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>