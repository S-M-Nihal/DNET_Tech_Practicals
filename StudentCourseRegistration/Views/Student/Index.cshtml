@model IEnumerable<StudentCourseRegistration.Models.Student>

@{
    ViewData["Title"] = "Student List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">Registered Students</h2>
        <small class="text-muted">Total Enrolled Students: <strong>@Model.Count()</strong></small>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">+ Register New Student</a>
</div>

@* One-time success banner passed via TempData after registering a student *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Email)</th>
                        <th>@Html.DisplayNameFor(model => model.Course)</th>
                        <th>@Html.DisplayNameFor(model => model.Semester)</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No students registered yet. Click <strong>Register New Student</strong> to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@student.Id</td>
                                <td class="fw-semibold">@student.Name</td>
                                <td>@student.Email</td>
                                <td>@student.Course</td>
                                <td><span class="badge bg-secondary">Sem @student.Semester</span></td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>