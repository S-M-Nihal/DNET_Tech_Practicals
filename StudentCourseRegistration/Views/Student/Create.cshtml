@model StudentCourseRegistration.Models.Student

@{
    ViewData["Title"] = "Register Student";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">Student Course Registration</h4>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Create" method="post">
                    @* Displays model-level validation errors if any occur *@
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g., Rohan Mehta" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="e.g., rohan@marwadiuniversity.ac.in" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Course" class="form-label fw-semibold"></label>
                        <select asp-for="Course" class="form-select">
                            <option value="">-- Select a Course --</option>
                            <option value=".NET Technologies (01CE1523)">.NET Technologies (01CE1523)</option>
                            <option value="Operating Systems">Operating Systems</option>
                            <option value="Database Management Systems">Database Management Systems</option>
                            <option value="Computer Networks">Computer Networks</option>
                            <option value="Machine Learning">Machine Learning</option>
                        </select>
                        <span asp-validation-for="Course" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Semester" class="form-label fw-semibold"></label>
                        <input asp-for="Semester" type="number" class="form-control" min="1" max="8" placeholder="Enter semester (1 to 8)" />
                        <span asp-validation-for="Semester" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Register Student</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}