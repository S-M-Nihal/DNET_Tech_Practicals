@model IEnumerable<SmartCampusPortal.Models.ServiceRequest>
@{
    ViewData["Title"] = "Smart Campus Command Center";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i><strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Live KPI Metrics Row (Synced via REST API /api/campus/stats) -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card shadow-sm bg-white p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Tickets</div>
                    <h2 class="fw-bold mb-0 text-primary" id="statTotal">@Model.Count()</h2>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-3 text-primary">
                    <i class="bi bi-ticket-detailed fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm bg-white p-3 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Pending Action</div>
                    <h2 class="fw-bold mb-0 text-warning" id="statPending">@Model.Count(r => r.Status == "Pending")</h2>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-3 text-warning">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm bg-white p-3 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">In Progress</div>
                    <h2 class="fw-bold mb-0 text-info" id="statInProgress">@Model.Count(r => r.Status == "In Progress")</h2>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-3 text-info">
                    <i class="bi bi-gear-wide-connected fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm bg-white p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Resolved</div>
                    <h2 class="fw-bold mb-0 text-success" id="statResolved">@Model.Count(r => r.Status == "Resolved")</h2>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-3 text-success">
                    <i class="bi bi-patch-check-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- API Search & Filter Control Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Search by Name, Roll No, Room, or Issue..." oninput="fetchRequestsFromApi()">
                </div>
            </div>
            <div class="col-md-3">
                <select id="categoryFilter" class="form-select" onchange="fetchRequestsFromApi()">
                    <option value="All">All Campus Departments</option>
                    <option value="IT Support">IT Support</option>
                    <option value="Lab Maintenance">Lab Maintenance</option>
                    <option value="Library">Library</option>
                    <option value="Hostel & Campus Wi-Fi">Hostel & Campus Wi-Fi</option>
                </select>
            </div>
            <div class="col-md-3">
                <select id="statusFilter" class="form-select" onchange="fetchRequestsFromApi()">
                    <option value="All">All Ticket Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Resolved">Resolved</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                <button class="btn btn-outline-secondary w-100" onclick="resetFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                </button>
            </div>
        </div>
    </div>
</div>

<!-- API Toast Notification -->
<div id="apiAlert" class="alert alert-info py-2 px-3 small d-none shadow-sm"></div>

<!-- Main Service Requests Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="bi bi-list-columns-reverse me-2 text-primary"></i>Campus Service Requests
        </h5>
        <span class="badge bg-light text-secondary border" id="apiStatusBadge">
            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Connected to REST API (/api/campus)
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-3">Ticket</th>
                    <th>Requester</th>
                    <th>Category & Location</th>
                    <th>Issue Description</th>
                    <th>Priority</th>
                    <th>Status (Live API Update)</th>
                    <th class="text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody id="requestsTableBody">
                @foreach (var item in Model)
                {
                    <tr id="row-@item.RequestId">
                        <td class="ps-3 fw-bold text-secondary">#@item.RequestId</td>
                        <td>
                            <div class="fw-semibold text-dark">@item.RequesterName</div>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.CampusId</span>
                        </td>
                        <td>
                            <div class="fw-semibold text-primary">@item.Category</div>
                            <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@item.Location</div>
                        </td>
                        <td style="max-width: 280px;">
                            <div class="small text-dark">@item.Description</div>
                            <div class="text-muted" style="font-size: 0.75rem;">@item.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                        </td>
                        <td>
                            @{
                                var pClass = item.Priority == "Critical" ? "bg-danger" :
                                             item.Priority == "High" ? "bg-warning text-dark" :
                                             item.Priority == "Medium" ? "bg-info text-dark" : "bg-secondary";
                            }
                            <span class="badge @pClass">@item.Priority</span>
                        </td>
                        <td>
                            <select class="form-select form-select-sm fw-semibold" style="width: 145px;"
                                    onchange="updateTicketStatus(@item.RequestId, this.value)">
                                <option value="Pending" selected="@(item.Status == "Pending")">Pending</option>
                                <option value="In Progress" selected="@(item.Status == "In Progress")">In Progress</option>
                                <option value="Resolved" selected="@(item.Status == "Resolved")">Resolved</option>
                            </select>
                        </td>
                        <td class="text-end pe-3">
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteTicket(@item.RequestId)" title="Delete via API">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function fetchRequestsFromApi() {
            const category = document.getElementById('categoryFilter').value;
            const status = document.getElementById('statusFilter').value;
            const search = document.getElementById('searchInput').value;

            const url = `/api/campus/requests?category=${encodeURIComponent(category)}&status=${encodeURIComponent(status)}&search=${encodeURIComponent(search)}`;
            const response = await fetch(url);
            const data = await response.json();

            const tbody = document.getElementById('requestsTableBody');
            tbody.innerHTML = '';

            if (data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">No matching campus service requests found.</td></tr>`;
                return;
            }

            data.forEach(item => {
                const pClass = item.priority === "Critical" ? "bg-danger" :
                    item.priority === "High" ? "bg-warning text-dark" :
                        item.priority === "Medium" ? "bg-info text-dark" : "bg-secondary";

                const dateStr = new Date(item.createdAt).toLocaleString();

                tbody.innerHTML += `
                        <tr id="row-${item.requestId}">
                            <td class="ps-3 fw-bold text-secondary">#${item.requestId}</td>
                            <td>
                                <div class="fw-semibold text-dark">${item.requesterName}</div>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border">${item.campusId}</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-primary">${item.category}</div>
                                <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>${item.location}</div>
                            </td>
                            <td style="max-width: 280px;">
                                <div class="small text-dark">${item.description}</div>
                                <div class="text-muted" style="font-size: 0.75rem;">${dateStr}</div>
                            </td>
                            <td><span class="badge ${pClass}">${item.priority}</span></td>
                            <td>
                                <select class="form-select form-select-sm fw-semibold" style="width: 145px;"
                                        onchange="updateTicketStatus(${item.requestId}, this.value)">
                                    <option value="Pending" ${item.status === 'Pending' ? 'selected' : ''}>Pending</option>
                                    <option value="In Progress" ${item.status === 'In Progress' ? 'selected' : ''}>In Progress</option>
                                    <option value="Resolved" ${item.status === 'Resolved' ? 'selected' : ''}>Resolved</option>
                                </select>
                            </td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteTicket(${item.requestId})">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>`;
            });
        }

        async function updateTicketStatus(id, newStatus) {
            const response = await fetch(`/api/campus/requests/${id}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });

            if (response.ok) {
                const result = await response.json();
                showApiFeedback(`REST API PATCH: ${result.message}`);
                refreshStats();
            }
        }

        async function deleteTicket(id) {
            if (!confirm(`Are you sure you want to delete Service Ticket #${id}?`)) return;

            const response = await fetch(`/api/campus/requests/${id}`, { method: 'DELETE' });
            if (response.ok) {
                document.getElementById(`row-${id}`)?.remove();
                showApiFeedback(`REST API DELETE: Ticket #${id} removed from database.`);
                refreshStats();
            }
        }

        async function refreshStats() {
            const res = await fetch('/api/campus/stats');
            const stats = await res.json();
            document.getElementById('statTotal').innerText = stats.total;
            document.getElementById('statPending').innerText = stats.pending;
            document.getElementById('statInProgress').innerText = stats.inProgress;
            document.getElementById('statResolved').innerText = stats.resolved;
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('categoryFilter').value = 'All';
            document.getElementById('statusFilter').value = 'All';
            fetchRequestsFromApi();
        }

        function showApiFeedback(msg) {
            const alertBox = document.getElementById('apiAlert');
            alertBox.innerHTML = `<i class="bi bi-broadcast me-2"></i><strong>Live API Event:</strong> ${msg}`;
            alertBox.classList.remove('d-none');
            setTimeout(() => alertBox.classList.add('d-none'), 3500);
        }
    </script>
}