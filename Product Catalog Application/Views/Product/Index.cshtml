@model IEnumerable<Product_Catalog_Application.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
    string currentCategory = ViewBag.SelectedCategory as string ?? "";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-primary mb-1">📦 Product Catalog</h2>
            <p class="text-muted small mb-0">Manage inventory items, pricing, and category filters</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> + Add New Product
            </a>
        </div>
    </div>

    <!-- Category Filter Bar -->
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
        <span class="text-secondary fw-semibold me-2">Filter by Category:</span>
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(currentCategory) ? "btn-dark" : "btn-outline-secondary")">
            All
        </a>
        <a asp-action="Index" asp-route-category="Electronics" class="btn btn-sm @(currentCategory.Equals("Electronics", StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary")">
            Electronics
        </a>
        <a asp-action="Index" asp-route-category="Accessories" class="btn btn-sm @(currentCategory.Equals("Accessories", StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary")">
            Accessories
        </a>
        <a asp-action="Index" asp-route-category="Stationery" class="btn btn-sm @(currentCategory.Equals("Stationery", StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary")">
            Stationery
        </a>
    </div>

    <!-- Products Table -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">ID</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock Status</th>
                        <th class="text-center" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <h5 class="fw-normal">No products found</h5>
                                    <p class="small mb-3">There are no items matching the selected filter or catalog.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-outline-primary">+ Add First Product</a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted fw-bold">#@item.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold text-dark">
                                        @item.Name
                                    </a>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-info text-dark px-3 py-1">
                                        @item.Category
                                    </span>
                                </td>
                                <td class="fw-bold text-success">
                                    @item.Price.ToString("C")
                                </td>
                                <td>
                                    @if (item.StockQuantity > 10)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            In Stock (@item.StockQuantity)
                                        </span>
                                    }
                                    else if (item.StockQuantity > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            Low Stock (@item.StockQuantity)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            Out of Stock
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            View
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete \'@item.Name\'?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>